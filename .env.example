NODE_ENV=development

# API / auth
HOST=0.0.0.0
PORT=4000
JWT_SECRET=troque-por-uma-chave-aleatoria-com-ao-menos-32-caracteres
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database
# Local Postgres example:
# DATABASE_URL=postgres://itguardian:itguardian@localhost:5432/itguardian
# Offline demo only:
# DATABASE_URL=memory
DATABASE_URL=
DB_SSL=false
# Opcional. O padrão é 1 na Vercel/serverless e 10 no servidor tradicional.
DB_POOL_MAX=
DB_CONNECTION_TIMEOUT_MS=10000
# Opcional. O padrão é 5s na Vercel/serverless e 30s no servidor tradicional.
DB_IDLE_TIMEOUT_MS=

# Frontend build-time variables
VITE_API_URL=http://localhost:4000
VITE_FRONTEND_URL=http://localhost:5173
VITE_ENABLE_WS=true
VITE_COLLECTOR_INSTALLER_URL=

# Dados demonstrativos ficam desligados. Ative apenas em ambiente descartavel.
ENABLE_DEMO_SEED=false
PING_MODE=mock
AGENT_OFFLINE_AFTER_MINUTES=10

# Integracoes reais (nenhum modo mock e aceito)
OCS_MODE=disabled
OCS_ENABLED=false
OCS_BASE_URL=
OCS_USER=
OCS_PASSWORD=
OCS_COMPUTERS_PATH=/computers
OCS_TIMEOUT_MS=10000
OCS_RETRIES=1
OCS_SYNC_INTERVAL_MINUTES=60
ZABBIX_MODE=disabled
ZABBIX_ENABLED=false
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
ZABBIX_TIMEOUT_MS=10000
ZABBIX_RETRIES=1
ZABBIX_SYNC_INTERVAL_MINUTES=5
INTEGRATION_STORE_RAW_DATA=false
STREAM_INTERVAL_MS=10000
ENABLE_REMOTE_SCRIPT_EXECUTION=false
VITE_ENABLE_REMOTE_SCRIPT_EXECUTION=false

# Assistencia remota: desligada por padrao e restrita a laboratorio autorizado.
ENABLE_REMOTE_ASSISTANCE=false
REMOTE_ASSISTANCE_ENV=disabled
ENABLE_REMOTE_CONTROL=false
ENABLE_REMOTE_PRIVACY_MODE=false
ENABLE_REMOTE_ADMIN_ACTIONS=false
REMOTE_ASSISTANCE_LAB_AUTO_CONSENT=false
REMOTE_ASSISTANCE_AGENT_TIMEOUT_SECONDS=45
VITE_ENABLE_REMOTE_ASSISTANCE=false
VITE_ENABLE_REMOTE_CONTROL=false
VITE_ENABLE_REMOTE_PRIVACY_MODE=false
VITE_ENABLE_REMOTE_ADMIN_ACTIONS=false
