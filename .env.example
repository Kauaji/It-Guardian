NODE_ENV=development

# API / auth
HOST=0.0.0.0
PORT=4000
JWT_SECRET=troque-por-uma-chave-aleatoria-com-ao-menos-32-caracteres
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database
# Local Postgres example:
# DATABASE_URL=postgres://itguardian:itguardian@localhost:5432/itguardian
# Offline demo only:
# DATABASE_URL=memory
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Frontend build-time variables
VITE_API_URL=http://localhost:4000
VITE_FRONTEND_URL=http://localhost:5173
VITE_ENABLE_WS=true

# Demo/future integrations
ENABLE_DEMO_SEED=false
PING_MODE=mock
AGENT_OFFLINE_AFTER_MINUTES=10
OCS_MODE=disabled
OCS_ENABLED=false
ZABBIX_MODE=disabled
ZABBIX_ENABLED=false
STREAM_INTERVAL_MS=10000
