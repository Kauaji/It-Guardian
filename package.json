{
  "name": "it-guardian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IT Guardian - infrastructure management with a native Windows collector and optional monitoring adapters.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && node scripts/prepare-vercel-output.mjs",
    "vercel-build": "npm run build",
    "start": "npm run start --workspace server",
    "seed:admin": "npm run seed:admin --workspace server --",
    "db:migrate": "npm run db:migrate --workspace server --",
    "db:status": "npm run db:status --workspace server --",
    "agent:enroll": "npm run agent:enroll --workspace server --",
    "agent:keys": "node scripts/agent-keys.mjs",
    "agent:sign-release": "node scripts/sign-agent-release.mjs",
    "product-key:create": "npm run product-key:create --workspace server --",
    "product-key:monitoring": "npm run product-key:monitoring --workspace server --",
    "floorplans:manifest": "node scripts/floor-plans/sync-3d-library-manifest.mjs",
    "floorplans:inspect-sh3f": "node scripts/floor-plans/inspect-sh3f.mjs",
    "installer:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File installers/windows-collector/build-installer.ps1",
    "test": "npm run test --workspace server",
    "test:client": "npm run test --workspace client",
    "test:client:coverage": "npm run test:coverage --workspace client",
    "test:coverage": "npm run test:coverage --workspace server",
    "test:integration": "npm run test:integration --workspace server",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"client/src/**/*.{js,jsx}\" \"server/src/**/*.{js,mjs}\" \"server/test-integration/**/*.mjs\" \"server/test-support/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.js\" playwright.config.js eslint.config.js",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx}\" \"server/src/**/*.{js,mjs}\" \"server/test-integration/**/*.mjs\" \"server/test-support/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.js\" playwright.config.js eslint.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:env": "node scripts/check-env-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:accents": "node scripts/check-ui-accents.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:architecture && npm run check:docs && npm run check:contrast && npm run check:accents && npm run test:coverage && npm run test:client && npm run build && npm run check:bundle",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/Start-ITGuardian.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/Stop-ITGuardian.ps1",
    "local:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/Reset-ITGuardian.ps1",
    "local:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/Backup-ITGuardian.ps1",
    "local:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/Restore-ITGuardian.ps1",
    "agent:test": "powershell -NoProfile -ExecutionPolicy Bypass -File agent/windows/Test-Agent.ps1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
