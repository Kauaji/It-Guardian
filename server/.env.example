HOST=0.0.0.0
PORT=4000
JWT_SECRET=troque-por-uma-chave-aleatoria-com-ao-menos-32-caracteres
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://itguardian:itguardian@localhost:5432/itguardian
DB_SSL=false
PING_MODE=mock
AGENT_OFFLINE_AFTER_MINUTES=10
OCS_MODE=disabled
OCS_ENABLED=false
OCS_BASE_URL=http://localhost/ocsapi/v1
OCS_USER=
OCS_PASSWORD=
OCS_COMPUTERS_PATH=/computers
OCS_TIMEOUT_MS=10000
OCS_RETRIES=1
OCS_SYNC_INTERVAL_MINUTES=60
ZABBIX_MODE=disabled
ZABBIX_ENABLED=false
ZABBIX_API_URL=http://localhost/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=
ZABBIX_TIMEOUT_MS=10000
ZABBIX_RETRIES=1
ZABBIX_SYNC_INTERVAL_MINUTES=5
INTEGRATION_STORE_RAW_DATA=false
STREAM_INTERVAL_MS=10000
ENABLE_REMOTE_SCRIPT_EXECUTION=false
ENABLE_REMOTE_ASSISTANCE=false
REMOTE_ASSISTANCE_ENV=disabled
ENABLE_REMOTE_CONTROL=false
ENABLE_REMOTE_PRIVACY_MODE=false
ENABLE_REMOTE_ADMIN_ACTIONS=false
REMOTE_ASSISTANCE_LAB_AUTO_CONSENT=false
REMOTE_ASSISTANCE_AGENT_TIMEOUT_SECONDS=45
REMOTE_ASSISTANCE_TRANSPORT=snapshot_polling
REMOTE_ASSISTANCE_TARGET_FPS=3
REMOTE_ASSISTANCE_MAX_FPS=3
REMOTE_ASSISTANCE_MAX_WIDTH=1280
REMOTE_ASSISTANCE_MAX_HEIGHT=720
REMOTE_ASSISTANCE_JPEG_QUALITY=65
REMOTE_ASSISTANCE_MIN_JPEG_QUALITY=35
REMOTE_ASSISTANCE_MAX_JPEG_QUALITY=80
REMOTE_ASSISTANCE_MAX_FRAME_BYTES=700000
REMOTE_ASSISTANCE_ADAPTIVE_QUALITY=true
REMOTE_ASSISTANCE_VIEWER_POLL_MS=350
REMOTE_ASSISTANCE_AGENT_CAPTURE_MS=350
REMOTE_ASSISTANCE_SESSION_TTL_MINUTES=20
REMOTE_ASSISTANCE_IDLE_TIMEOUT_SECONDS=60
REMOTE_ASSISTANCE_RECONNECT_GRACE_SECONDS=30
REMOTE_ASSISTANCE_WEBRTC_ENABLED=false
REMOTE_ASSISTANCE_STUN_URLS=
REMOTE_ASSISTANCE_TURN_URL=
REMOTE_ASSISTANCE_TURN_USERNAME=
REMOTE_ASSISTANCE_TURN_PASSWORD=
REMOTE_ASSISTANCE_MAX_BITRATE_KBPS=2500

# Relay externo (Redis/Upstash): opcional local/Docker, obrigatorio em
# deploy serverless (Vercel) para o relay ser compartilhado entre instancias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auto-atualizacao do agente Windows: as tres variaveis abaixo sao exigidas
# EM CONJUNTO (qualquer uma ausente desativa a funcionalidade). URL precisa
# ser https e o hash precisa ser o SHA-256 (hex, 64 caracteres) do executavel
# publicado — o agente recusa a atualizacao se o hash nao bater.
AGENT_LATEST_VERSION=
AGENT_LATEST_VERSION_URL=
AGENT_LATEST_VERSION_SHA256=

# ---------------------------------------------------------------------------
# Identidade e sessao (docs/IDENTIDADE-E-SESSAO.md)
# ---------------------------------------------------------------------------
# Ociosidade e vida absoluta da sessao (segundos). Rotacao do token apos N segundos de uso.
SESSION_IDLE_SECONDS=28800
SESSION_MAX_AGE_SECONDS=28800
SESSION_ABSOLUTE_SECONDS=43200
SESSION_ROTATE_AFTER_SECONDS=900
# Custo do bcrypt (10-14) e bloqueio progressivo apos N falhas seguidas de login.
PASSWORD_HASH_COST=12
LOGIN_LOCKOUT_THRESHOLD=5
AUTH_RATE_LIMIT_MAX=20
# Exige MFA (TOTP) de administradores; chave de 32+ caracteres que cifra os segredos TOTP (padrao: derivada do JWT_SECRET).
MFA_REQUIRED_FOR_ADMINS=false
MFA_ENCRYPTION_KEY=
# Em producao o cadastro inicial pela internet exige este token (ou crie o admin com `npm run seed:admin`).
SETUP_TOKEN=
# Dados de demonstracao criam admins com senha publica: ignorados em producao salvo DEMO_SEED_ALLOW_PRODUCTION=true.
ENABLE_DEMO_SEED=false
IT_GUARDIAN_ENABLE_DEMO_SEED=
DEMO_SEED_ALLOW_PRODUCTION=false
CLIENT_ORIGIN=
IT_GUARDIAN_ENVIRONMENT=
REMOTE_ASSISTANCE_ENVIRONMENT=

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# auto|verify|no-verify. Em `auto` o TLS do banco e verificado quando DB_SSL_CA existe; senao segue sem verificar (com aviso).
DB_SSL_MODE=auto
# Certificado da CA do provedor (PEM, aceita \n literais). Fecha o aviso db_tls_unverified.
DB_SSL_CA=
DB_MODE=
DB_POOL_MAX=
DB_CONNECTION_TIMEOUT_MS=
DB_IDLE_TIMEOUT_MS=
# auto: aplica esquema + migracoes ao subir | check: recusa subir se faltar migracao (use `npm run db:migrate` no deploy) | skip: nao toca no esquema.
MIGRATIONS_MODE=auto

# ---------------------------------------------------------------------------
# Retencao de dados (job diario; 0 desliga as tabelas opcionais)
# ---------------------------------------------------------------------------
RETENTION_HEARTBEAT_DAYS=30
RETENTION_METRIC_HISTORY_DAYS=90
RETENTION_AUTH_SESSION_DAYS=30
RETENTION_REAUTH_DAYS=7
RETENTION_REAUTH_ATTEMPT_DAYS=180
RETENTION_AUDIT_LOG_DAYS=0
RETENTION_BATCH_SIZE=5000
# Segredo exigido (Authorization: Bearer) pelas rotas de cron na Vercel.
CRON_SECRET=
PREVENTIVE_CRON_SECRET=

# ---------------------------------------------------------------------------
# Observabilidade (docs/OBSERVABILIDADE.md)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# /metrics (formato Prometheus) so existe com este token.
METRICS_TOKEN=
# Reporte de erros 5xx: DSN estilo Sentry e/ou webhook generico.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
ERROR_WEBHOOK_URL=
APP_VERSION=
HOSTNAME=
# Limites por minuto da API (por credencial; anonimo por IP).
API_RATE_LIMIT_PER_MINUTE=1500
API_MUTATION_RATE_LIMIT_PER_MINUTE=400
API_ANONYMOUS_RATE_LIMIT_PER_MINUTE=300
API_ANONYMOUS_MUTATION_RATE_LIMIT_PER_MINUTE=60
AGENT_OFFLINE_AFTER_SECONDS=

# ---------------------------------------------------------------------------
# Assinatura do agente Windows (docs/SEGURANCA-DO-AGENTE.md)
# ---------------------------------------------------------------------------
# Chave PRIVADA (PEM) que assina cada job de script entregue ao agente: `npm run agent:keys -- jobs`.
AGENT_JOB_SIGNING_PRIVATE_KEY=
# Assinatura do manifesto de atualizacao, feita FORA do servidor com a chave de release
# (`npm run agent:sign-release`). Sem ela a atualizacao nao e oferecida.
AGENT_LATEST_VERSION_SIGNATURE=
# Opcional: chave PUBLICA de release para o servidor conferir a assinatura antes de oferecer a atualizacao.
AGENT_RELEASE_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Assistencia remota (variaveis adicionais; ver docs/ASSISTENCIA-REMOTA.md)
# ---------------------------------------------------------------------------
ENABLE_REMOTE_ASSISTANCE_CONTROL=
ENABLE_REMOTE_ASSISTANCE_AUTO_CONSENT=
REMOTE_ASSISTANCE_MAX_QUEUED_COMMANDS=
REMOTE_ASSISTANCE_TURN_CREDENTIAL=
REMOTE_ASSISTANCE_METERED_DOMAIN=
REMOTE_ASSISTANCE_METERED_SECRET_KEY=
REMOTE_ASSISTANCE_RUSTDESK_ENABLED=false
REMOTE_ASSISTANCE_RUSTDESK_ID_SERVER=
REMOTE_ASSISTANCE_RUSTDESK_RELAY_SERVER=
REMOTE_ASSISTANCE_RUSTDESK_PASSWORD_TTL_SECONDS=
REMOTE_ASSISTANCE_RUSTDESK_PASSWORD_LENGTH=

# Alternativas de URL do Redis fornecidas pela integracao Vercel KV e variaveis da Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
VERCEL_BRANCH_URL=
VERCEL_PROJECT_PRODUCTION_URL=
