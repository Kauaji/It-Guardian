{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "client/src/api/**/*.js",
    "client/src/permissions.js",
    "client/src/authSession.js",
    "client/src/utils/**/*.js",
    "client/src/config/**/*.js",
    "server/src/lib/**/*.js",
    "server/src/security/**/*.js",
    "server/src/config/**/*.js",
    "server/src/middleware/**/*.js",
    "server/src/types/**/*.d.ts"
  ],
  "exclude": [
    "**/*.test.js",
    "**/*.test.jsx",
    "**/*.test.mjs",
    "**/node_modules",
    "**/dist",
    "server/src/middleware/authMiddleware.js"
  ]
}
